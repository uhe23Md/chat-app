# ============================================================
# 环境变量示例文件
#
# 用法：复制成 .env 再改成自己的值
#   cp .env.example .env        （Windows: copy .env.example .env）
#
# ⚠️ .env 里有密钥，已在 .gitignore 里排除，绝对不会进仓库。
#    这个 .env.example 是可以进仓库的，所以这里只能放占位值。
# ============================================================

# ---- 服务端口 ----
# 本地开发固定 3000 就行。
# ⚠️ 部署到云平台时不要设置这个变量！
#    云平台（Render/Railway/Heroku）会自动注入 PORT，
#    代码里读的就是它注入的值。你手动设了反而会冲突。
PORT=3000

# ---- JWT 签名密钥 ----
# 必须改！这是签发登录 token 的密钥，泄露 = 别人能伪造任何人的登录态。
# 生成方法（复制到终端执行）：
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_random_long_string

# ---- SQLite 数据库文件路径 ----
# 本地：留空或写 ./chat.db（代码会 resolve 成项目根目录的绝对路径）
# 线上：挂持久卷的话，指到卷的挂载点，例如 /data/chat.db
DB_PATH=./chat.db

# ---- CORS 白名单（只有线上需要）----
# 本项目前后端同源部署，正常访问用不到 CORS。
# 配置它属于"纵深防御"：万一将来前端拆出去单独部署，或者有人拿你的 API 做跨站调用，
# 白名单能挡住。
#
# 多个来源用英文逗号分隔，不要带结尾斜杠：
#   ALLOWED_ORIGINS=https://chat-app.onrender.com,https://chat.example.com
#
# 本地开发不用设这个，代码会自动放开所有来源。
# ALLOWED_ORIGINS=

# ---- 运行环境 ----
# 云平台一般会自动注入（RENDER / DYNO / RAILWAY_ENVIRONMENT 等），
# 代码里会自动识别，通常不需要手动设。
# 如果平台比较小众，识别不出来，就手动设这一条切到生产模式：
# NODE_ENV=production
