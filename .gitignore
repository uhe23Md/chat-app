# 依赖
node_modules/

# 环境变量（含密钥，绝不进仓库）
.env
.env.local
.env.*.local

# SQLite 数据库文件
# ⚠️ 别忘了 -shm 和 -wal：数据库开了 WAL 模式后，会常驻这两个附属文件
#    （共享内存索引 + 预写日志）。它们和 .db 一样是运行时产物，
#    里面存着还没合并进主库的数据，不该进版本库。
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3

# 日志
*.log
npm-debug.log*

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/
